# Postgres (matches docker-compose defaults)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lemkb
POSTGRES_USER=lemkb
POSTGRES_PASSWORD=lemkb

# MinIO locally; swap endpoint/keys for real AWS S3 later (leave S3_ENDPOINT empty for AWS)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=lemkbadmin
S3_SECRET_KEY=lemkbadmin123
S3_BUCKET=lemkb
S3_REGION=us-east-1

# Required by Unpaywall and recommended by OpenAlex/Crossref ("polite pool").
# Use a real company address. If empty, Unpaywall is skipped.
CONTACT_EMAIL=

# Optional: enables the CORE repository source (free key at https://core.ac.uk/services/api)
CORE_API_KEY=

# Publisher text-and-data-mining (TDM) APIs. The free self-service tokens from Wiley
# (https://onlinelibrary.wiley.com/library-info/resources/text-and-datamining) and
# Elsevier (https://dev.elsevier.com) are for NON-COMMERCIAL research only. For Lemnisca,
# fill these only with credentials issued under a commercial TDM agreement.
WILEY_TDM_TOKEN=
ELSEVIER_API_KEY=
ELSEVIER_INSTTOKEN=

# PDF parser (docker-compose service)
GROBID_URL=http://localhost:8070

# --- Moving to AWS S3 (lemkb s3-check / s3-migrate) ---
# Use a bucket dedicated to this knowledge base. Credentials: either fill the two keys
# below (an IAM user limited to this bucket), or leave them empty and use AWS_PROFILE /
# ~/.aws/credentials / an SSO or instance role.
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Moving Postgres to AWS RDS (lemkb db-check / db-migrate / db-switch) ---
RDS_HOST=
RDS_PORT=5432
RDS_DB=lemkb
RDS_USER=lemkb_admin
RDS_PASSWORD=

# --- For examples/agent.py (Claude API key from console.anthropic.com) ---
ANTHROPIC_API_KEY=
